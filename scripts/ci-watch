#!/bin/sh
# Waits until no check of a pull request is pending, prints each check with its result and link,
# and exits 0 only when every check passed and every required check was reported.
#
#   scripts/ci-watch [--timeout SECONDS] [--interval SECONDS] [--require NAME]... <pull request | branch>
#
# It watches a pull request, or a branch that has one. For the checks of a commit pushed without a
# pull request use `gh run list --branch <branch>`.
#
# A required check is named as `gh pr checks` prints it: `--require NAME`, repeated once per check,
# or CI_WATCH_REQUIRE, one name per line; the default is `canon / task check`, the job of
# `.github/workflows/check.yml`.
#
# Exit status: 0 every check passed (a skipped check counts as passed) and every required check was
# reported, 1 a check failed or was cancelled or a required check is missing from the reported
# ones, 2 a check was still pending at the timeout, or no check was reported, or the argument names
# no pull request, or a usage error.
# `gh` is taken from CI_WATCH_GH when set, else from PATH.
set -eu

timeout=3600
interval=20
target=
required=
while [ $# -gt 0 ]; do
  case $1 in
    --timeout) timeout=${2:?--timeout needs seconds}; shift 2 ;;
    --interval) interval=${2:?--interval needs seconds}; shift 2 ;;
    --require)
      name=${2:?--require needs the name of a check}
      required=${required:+$required
}$name
      shift 2 ;;
    -h|--help) sed -n '2,18p' "$0"; exit 0 ;;
    -*) echo "ci-watch: unknown option $1" >&2; exit 2 ;;
    *) target=$1; shift ;;
  esac
done
[ -n "$target" ] || { echo "usage: ci-watch [--timeout S] [--interval S] [--require NAME]... <pull request | branch>" >&2; exit 2; }
[ -n "$required" ] || required=${CI_WATCH_REQUIRE:-canon / task check}

gh=${CI_WATCH_GH:-gh}
start=$(date +%s)

while :; do
  # `gh pr checks` prints tab separated: name, result, elapsed, link. Its own exit status says
  # "pending" or "failed" and is not read: the table is.
  answer=$($gh pr checks "$target" 2>&1) || true
  case $answer in
    *"no pull requests found"*)
      echo "ci-watch: $target names no open pull request; ci-watch watches a pull request (or a branch that has one); for the checks of a pushed commit use: gh run list --branch <branch>" >&2
      exit 2 ;;
  esac
  counts=$(printf '%s\n' "$answer" | awk -F '\t' '
    NF >= 2 { total++; r = $2
      if (r == "pass" || r == "skipping") ok++
      else if (r == "fail" || r == "cancel") bad++
      else pend++ }
    END { printf "%d %d %d %d", total, ok, bad, pend }')
  # shellcheck disable=SC2086
  set -- $counts
  total=$1 bad=$3 pend=$4
  if [ "$total" -gt 0 ] && [ "$pend" -eq 0 ]; then
    printf '%s\n' "$answer" | awk -F '\t' 'NF >= 2 { printf "%-9s %s  %s\n", $2, $1, $4 }'
    reported=$(printf '%s\n' "$answer" | awk -F '\t' 'NF >= 2 { print $1 }')
    missing=
    while IFS= read -r name; do
      [ -n "$name" ] || continue
      printf '%s\n' "$reported" | grep -Fxq -- "$name" ||
        missing=${missing:+$missing, }\`$name\`
    done <<EOF
$required
EOF
    status=0
    if [ "$bad" -gt 0 ]; then
      echo "ci-watch: $bad check(s) failed or were cancelled" >&2
      status=1
    fi
    if [ -n "$missing" ]; then
      echo "ci-watch: required check(s) never reported: $missing" >&2
      status=1
    fi
    [ "$status" -eq 0 ] || exit "$status"
    echo "ci-watch: all $total check(s) passed"
    exit 0
  fi
  now=$(date +%s)
  if [ $((now - start)) -ge "$timeout" ]; then
    if [ "$total" -gt 0 ]; then
      printf '%s\n' "$answer" | awk -F '\t' 'NF >= 2 { printf "%-9s %s  %s\n", $2, $1, $4 }'
    else
      printf '%s\n' "$answer"
    fi
    echo "ci-watch: timeout after ${timeout}s: $pend check(s) pending, $total reported" >&2
    exit 2
  fi
  echo "ci-watch: waiting ($total reported, $pend pending)" >&2
  sleep "$interval"
done
