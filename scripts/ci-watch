#!/bin/sh
# Waits until no check of a pull request or branch is pending, prints each check with its result
# and link, and exits 0 only when every check passed.
#
#   scripts/ci-watch [--timeout SECONDS] [--interval SECONDS] <pull request number | branch>
#
# Exit status: 0 every check passed (a skipped check counts as passed), 1 a check failed or was
# cancelled, 2 a check was still pending at the timeout, or no check was reported, or a usage error.
# `gh` is taken from CI_WATCH_GH when set, else from PATH.
set -eu

timeout=3600
interval=20
target=
while [ $# -gt 0 ]; do
  case $1 in
    --timeout) timeout=${2:?--timeout needs seconds}; shift 2 ;;
    --interval) interval=${2:?--interval needs seconds}; shift 2 ;;
    -h|--help) sed -n '2,10p' "$0"; exit 0 ;;
    -*) echo "ci-watch: unknown option $1" >&2; exit 2 ;;
    *) target=$1; shift ;;
  esac
done
[ -n "$target" ] || { echo "usage: ci-watch [--timeout S] [--interval S] <pull request | branch>" >&2; exit 2; }

gh=${CI_WATCH_GH:-gh}
start=$(date +%s)

while :; do
  # `gh pr checks` prints tab separated: name, result, elapsed, link. Its own exit status says
  # "pending" or "failed" and is not read: the table is.
  answer=$($gh pr checks "$target" 2>&1) || true
  counts=$(printf '%s\n' "$answer" | awk -F '\t' '
    NF >= 2 { total++; r = $2
      if (r == "pass" || r == "skipping") ok++
      else if (r == "fail" || r == "cancel") bad++
      else pend++ }
    END { printf "%d %d %d %d", total, ok, bad, pend }')
  # shellcheck disable=SC2086
  set -- $counts
  total=$1 bad=$3 pend=$4
  if [ "$total" -gt 0 ] && [ "$pend" -eq 0 ]; then
    printf '%s\n' "$answer" | awk -F '\t' 'NF >= 2 { printf "%-9s %s  %s\n", $2, $1, $4 }'
    if [ "$bad" -gt 0 ]; then
      echo "ci-watch: $bad check(s) failed or were cancelled" >&2
      exit 1
    fi
    echo "ci-watch: all $total check(s) passed"
    exit 0
  fi
  now=$(date +%s)
  if [ $((now - start)) -ge "$timeout" ]; then
    if [ "$total" -gt 0 ]; then
      printf '%s\n' "$answer" | awk -F '\t' 'NF >= 2 { printf "%-9s %s  %s\n", $2, $1, $4 }'
    else
      printf '%s\n' "$answer"
    fi
    echo "ci-watch: timeout after ${timeout}s: $pend check(s) pending, $total reported" >&2
    exit 2
  fi
  echo "ci-watch: waiting ($total reported, $pend pending)" >&2
  sleep "$interval"
done
